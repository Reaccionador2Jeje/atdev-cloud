NODE_ENV=development
PORT=3000
HOST=127.0.0.1
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment
DATABASE_PATH=./data/atdev-cloud.sqlite
STORAGE_PATH=./storage
MAX_UPLOAD_MB=10
CORS_ORIGIN=http://localhost:5173

# AtDev DB HTTP service
ATDEV_DB_URL=http://127.0.0.1:8788

# Optional private PostgreSQL authentication service (Cloudflare Worker deployment)
AUTH_SERVICE_URL=
AUTH_SERVICE_TOKEN=
