{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atdev-cloud",
  "main": "./dist/worker.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "atdev-cloud-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atdev-cloud-db",
      "database_id": "2bd7bc05-3f00-4faf-9dff-054b0c50b98a",
      "migrations_dir": "./migrations"
    }
  ]
}
